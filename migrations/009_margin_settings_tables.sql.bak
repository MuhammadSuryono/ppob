-- Migration: 009_margin_and_commission_tables.sql
-- Description: Add margin settings and commission tables for financial operations

-- Staff Global Margin Settings Table
CREATE TABLE IF NOT EXISTS staff_global_margin_settings (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    commission_type VARCHAR(20) NOT NULL DEFAULT 'MarginShare',
    global_margin_percent DECIMAL(5,2) NOT NULL DEFAULT 0,
    fixed_allowance DECIMAL(15,2) NOT NULL DEFAULT 0,
    is_active BOOLEAN NOT NULL DEFAULT true,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT unique_staff_margin_settings UNIQUE (user_id)
);

CREATE INDEX idx_staff_margin_user_id ON staff_global_margin_settings(user_id);

-- Staff Product Margin Overrides Table
CREATE TABLE IF NOT EXISTS staff_product_margin_overrides (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL,
    product_code VARCHAR(100) NOT NULL,
    margin_percent DECIMAL(5,2) NOT NULL DEFAULT 0,
    fixed_margin DECIMAL(15,2) NOT NULL DEFAULT 0,
    is_active BOOLEAN NOT NULL DEFAULT true,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT unique_product_override UNIQUE (user_id, product_code)
);

CREATE INDEX idx_product_override_user ON staff_product_margin_overrides(user_id);
CREATE INDEX idx_product_override_code ON staff_product_margin_overrides(product_code);

